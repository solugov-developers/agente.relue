# Variáveis necessárias na Vercel (copie os VALORES do seu .env.local)

# Banco (Supabase — pooler). Em serverless, se houver erro de conexão, troque para o
# Transaction Pooler (porta 6543).
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=postgres

# Azure OpenAI (chat + IA do edital)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Segredo de sessão do login (gere com: openssl rand -hex 32)
AUTH_SECRET=
